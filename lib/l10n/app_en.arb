{
  "@@locale": "en",
  "appTitle": "WikiTree Viewer",
  "@appTitle": {
    "description": "The app name. A brand: keep it untranslated."
  },
  "tagline": "Your family tree, one tap at a time.",
  "disclaimer": "Unofficial viewer. Family data comes from WikiTree.com and remains subject to their terms. Nothing is edited or stored on this device.",
  "loadingFamily": "Loading family…",

  "lookupLabel": "Family code or link",
  "lookupClear": "Clear",
  "lookupSubmit": "Show family tree",
  "lookupBusy": "Looking up…",
  "lookupPaste": "Paste a link",
  "lookupRecentTitle": "Recently opened",
  "lookupExamplePrompt": "First time here? Open an example to see how a tree looks.",
  "lookupExampleTry": "Try",
  "@lookupExampleTry": {
    "description": "Label in front of the first example code; the code next to it is the button."
  },
  "lookupExampleOr": "or",
  "@lookupExampleOr": {
    "description": "Label between the two example codes, which are both buttons."
  },

  "treeCloseTooltip": "Close the tree",
  "@treeCloseTooltip": {
    "description": "Tooltip on the X in the corner of the tree screen: leaves the tree and returns to the first screen."
  },
  "treeBackTooltip": "Back to the person before",
  "@treeBackTooltip": {
    "description": "Tooltip on the arrow next to the X: steps back through the people the walk through the family visited."
  },
  "treeTipsTitle": "Using the tree",
  "@treeTipsTitle": {
    "description": "Title of the how-to dialog shown the first time a tree is opened."
  },
  "treeTipsSwipe": "Drag with one finger to move around",
  "@treeTipsSwipe": {
    "description": "One line of the first-run tree hints: panning."
  },
  "treeTipsZoom": "Pinch or spread two fingers to zoom",
  "@treeTipsZoom": {
    "description": "One line of the first-run tree hints: zooming."
  },
  "treeTipsTap": "Tap a person to make them the middle of the tree",
  "@treeTipsTap": {
    "description": "One line of the first-run tree hints: tapping re-centres the tree on that person."
  },
  "treeTipsLongPress": "Press and hold a person for their details",
  "@treeTipsLongPress": {
    "description": "One line of the first-run tree hints: long-pressing opens the details sheet."
  },
  "treeTipsDismiss": "Got it",
  "@treeTipsDismiss": {
    "description": "Button that closes the first-run tree hints."
  },
  "moreCount": "{count, plural, =1{1 more} other{{count} more}}",
  "@moreCount": {
    "description": "Label of the buttons that load another generation, where WikiTree knows how many people are waiting.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "moreUnknown": "More",
  "@moreUnknown": {
    "description": "Label used when the count of people waiting could not be fetched."
  },
  "shareTooltip": "Share this family",
  "shareSheetTitle": "Share this family",
  "shareWithApp": "Share with an app",
  "shareWithAppSubtitle": "Messages, email, WhatsApp and the rest",
  "shareCopyLink": "Copy the link",
  "shareCopyLinkSubtitle": "Paste it wherever you like",
  "shareCopied": "Link copied. Paste it anywhere.",
  "shareFailed": "This device can't share. Try copying the link.",
  "shareSubject": "Family tree: {name}",
  "@shareSubject": {
    "description": "Subject line handed to the share sheet.",
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },

  "shareTitleWithDates": "View {name}'s ({lifeSpan}) family tree in {app}: {link}",
  "@shareTitleWithDates": {
    "description": "The shared message, for somebody with known dates. It ends in the link so that the link is the last thing a chat app has to recognise.",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "lifeSpan": {
        "type": "String",
        "example": "1879–1955"
      },
      "app": {
        "type": "String"
      },
      "link": {
        "type": "String"
      }
    }
  },
  "shareTitle": "View {name}'s family tree in {app}: {link}",
  "@shareTitle": {
    "description": "The shared message, for somebody whose dates are unknown.",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "app": {
        "type": "String"
      },
      "link": {
        "type": "String"
      }
    }
  },
  "shareInstall": "Don't have {app}? Get it here: {url}",
  "@shareInstall": {
    "description": "Second line of a shared message: where to get the app.",
    "placeholders": {
      "app": {
        "type": "String"
      },
      "url": {
        "type": "String"
      }
    }
  },

  "privateProfile": "Private profile",
  "@privateProfile": {
    "description": "Shown in place of a name when WikiTree releases nothing about a person except their id."
  },
  "notPublic": "Not public",
  "@notPublic": {
    "description": "Second line under a name in the tree whose profile is not public."
  },
  "nameLater": "{name} (later {surname})",
  "@nameLater": {
    "description": "Full name of somebody who took a different surname later in life.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Anna Maria Schmidt"
      },
      "surname": {
        "type": "String",
        "example": "Meyer"
      }
    }
  },
  "yearRange": "{birth}–{death}",
  "@yearRange": {
    "description": "Years of birth and death. Keep the en dash between the placeholders.",
    "placeholders": {
      "birth": {
        "type": "int"
      },
      "death": {
        "type": "int"
      }
    }
  },
  "bornYear": "b. {year}",
  "@bornYear": {
    "description": "Abbreviation of 'born', used when somebody has no death date.",
    "placeholders": {
      "year": {
        "type": "int"
      }
    }
  },
  "diedYear": "d. {year}",
  "@diedYear": {
    "description": "Abbreviation of 'died', used when the birth date is unknown.",
    "placeholders": {
      "year": {
        "type": "int"
      }
    }
  },
  "datesUnknown": "Dates unknown",
  "unknown": "Unknown",
  "married": "m. {date}",
  "@married": {
    "description": "Abbreviation of 'married', followed by the marriage date.",
    "placeholders": {
      "date": {
        "type": "String",
        "example": "2 Feb 1870"
      }
    }
  },
  "marriedAndEnded": "m. {start}, ended {end}",
  "@marriedAndEnded": {
    "description": "A marriage that ended, by divorce or by death.",
    "placeholders": {
      "start": {
        "type": "String"
      },
      "end": {
        "type": "String"
      }
    }
  },
  "personSemantics": "{name}, {lifeSpan}",
  "@personSemantics": {
    "description": "Screen-reader label for a photo or monogram.",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "lifeSpan": {
        "type": "String"
      }
    }
  },
  "treeMiddleSemantics": "middle of the tree",
  "@treeMiddleSemantics": {
    "description": "Screen-reader suffix for the person the tree is centred on."
  },
  "treeNotPublicSemantics": "profile not public",
  "@treeNotPublicSemantics": {
    "description": "Screen-reader suffix for a person whose profile WikiTree keeps hidden."
  },

  "born": "Born",
  "died": "Died",
  "living": "Living",
  "notRecorded": "Not recorded",
  "ageAtDeath": "age {age}",
  "@ageAtDeath": {
    "placeholders": {
      "age": {
        "type": "int"
      }
    }
  },
  "parents": "Parents",
  "noParents": "No parents recorded on WikiTree",
  "spouses": "Spouses",
  "siblings": "Brothers and sisters",
  "halfSiblings": "Half-brothers and half-sisters",
  "children": "Children",
  "noChildren": "No children recorded on WikiTree",
  "openOnWikiTree": "Open on WikiTree",
  "couldNotOpenWikiTree": "Could not open WikiTree.",
  "privateProfileNotice": "WikiTree limits what it shares about this profile. Dates and places may be missing, and relatives may not be listed.",
  "marriageEndedNote": "A marriage that ended is shown with its end date.",

  "errorEmptyKey": "Enter a WikiTree ID or a profile link.",
  "errorTooLongKey": "That's too long to be a WikiTree ID. It usually looks like Windsor-1.",
  "errorNoIdFound": "We couldn't find a WikiTree ID in that. Try something like Windsor-1.",
  "errorAmbiguousKey": "That looks like more than one WikiTree ID. Please enter just one.",
  "errorSpaceProfile": "That's a free-space page, not a person. This app shows people only.",
  "errorUnsupportedHost": "That link isn't a WikiTree profile link.",
  "errorMalformedKey": "That WikiTree ID doesn't look right. Example: Windsor-1",
  "hintPasteLink": "You can also paste a link like https://www.wikitree.com/wiki/Windsor-1",
  "hintLinkStart": "Links need to start with https://www.wikitree.com/wiki/",
  "errorNotFound": "We couldn't find that person on WikiTree.",
  "hintNotFound": "Check the code, or paste the profile link instead.",
  "errorPrivate": "That profile is private.",
  "hintPrivate": "WikiTree limits what is shared about living people.",
  "errorTimeout": "WikiTree took too long to answer.",
  "errorNetwork": "Can't reach WikiTree.",
  "hintNetwork": "Check your internet connection, then try again.",
  "errorRateLimit": "WikiTree asked us to slow down.",
  "hintRateLimit": "Please wait a minute, then try again.",
  "errorServer": "WikiTree had a problem answering that.",
  "hintServer": "This is usually temporary. Please try again.",
  "errorParse": "We couldn't read WikiTree's answer.",
  "hintParse": "Please try again in a moment."
}

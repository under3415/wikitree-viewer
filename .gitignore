# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Written by `flutter gen-l10n`: the list of keys a translation is missing
l10n_untranslated.json

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing material. The keystore is the app's identity, not a build artefact:
# anyone holding it can publish an update that Android treats as this app.
# `android/.gitignore` covers these too; repeating them here means a keystore
# dropped at the repository root cannot slip in either.
android/key.properties
*.jks
*.keystore

# Machine-specific files and local secrets.
local.properties
.env
.env.*
